# /etc/systemd/system/fluxo-api.service
# Logs:      journalctl -u fluxo-api -f
# Controle:  systemctl status|restart|stop fluxo-api
[Unit]
Description=API Fluxo de Chamados (Workflow Datapar)
Wants=network-online.target
After=network-online.target mariadb.service mysql.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=fluxo
Group=fluxo
WorkingDirectory=/var/www/html/fluxo-chamados
EnvironmentFile=/etc/fluxo-api/fluxo-api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --enable-source-maps dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fluxo-api

# Limites
MemoryMax=512M
LimitNOFILE=65535

# Endurecimento (a API não precisa escrever em disco)
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
